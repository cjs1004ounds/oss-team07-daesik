# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채웁니다.
# .env는 저장소에 올리지 않습니다.

# 서버 포트
PORT=3000

# 실행 중에 쓰는 데이터 폴더. 정하지 않으면 data/runtime을 씁니다.
# 바꾸고 싶을 때만 앞의 #을 지우고 값을 넣습니다.
# 빈 값으로 두면 Docker로 실행할 때 이미지에 정해 둔 값(/data)을 덮어써서 저장이 안 됩니다
# DATA_DIR=

# 카카오 로컬 API (가게 검색). 카카오 디벨로퍼스에서 발급받은 REST API 키
KAKAO_REST_API_KEY=

# 카카오맵 (첫 화면 지도). 카카오 디벨로퍼스의 JavaScript 키.
# 브라우저에 보이는 값이라 카카오 디벨로퍼스에서 허용 도메인을 꼭 걸어 둡니다
KAKAO_JS_KEY=

# 교내 인증의 학교 와이파이 판정 (R12).
# 학교 와이파이로 접속했을 때 서버가 본 IP의 앞부분. 여러 개면 쉼표로 나눕니다. 예: 203.0.113.
# 비워 두면 와이파이 판정은 하지 않고 위치로만 인증합니다
CAMPUS_IP_PREFIXES=
